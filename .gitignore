# Simulink & Code Generation
# Simulink internal cache and simulation target folders
slprj/
sccprj/

# Embedded Coder / MATLAB Coder generated code folders
codegen/

# Simulink cache files (R2023a and newer)
*.slxc

# Simulink model backup/autosave files
*.slx.r*
*.mdl.r*


# MATLAB Core & Editor Files
# MATLAB autosave files
*.asv
*.m~
*.autosave
*.bak

# Compiled MEX files (platform-dependent binaries)
*.mex*

# Derived content-obscured files
*.p

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives
*.ctf

# Generated helpsearch folders
helpsearch/

# Cloud-based storage dotfile
.MATLABDriveTag


# Environment & generated C++ 
# Local environment config (copy .env.example to .env)
.env
.env.*
!.env.example

# Runtime output (TLE caches, telemetry logs, demo results) - ADCS_DATA_DIR default
output/

# C++ generated by MATLAB Coder (matlab/codegen/build_cpp.m)
cpp/generated/

# C++ build output
cpp/build/
build/
