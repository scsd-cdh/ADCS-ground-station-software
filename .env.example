# Copy to .env and edit. Real environment variables override values in .env.
# The C++ reads these as environment variables (a .env file is not loaded yet).

# Spacecraft NORAD catalog ID (required). 25544 = ISS, a stand-in until SC-FREYR
# is catalogued (CelesTrak data for new launches appeared ~48 h after launch).
ADCS_NORAD_ID=25544

# CelesTrak GP endpoint; ?CATNR=<id>&FORMAT=TLE is appended.
# Usage plan: at most 5 pulls per day, at least 90 min apart (enforced in code).
# See the FAQ Addendum section: https://celestrak.org/NORAD/documentation/gp-data-formats.php
ADCS_TLE_SOURCE_URL=https://celestrak.org/NORAD/elements/gp.php

# Optional: use this TLE file instead of CelesTrak (no network). For the period
# before NORAD publishes a TLE, or for Space-Track and other sources.
# ADCS_TLE_FILE=

# Where the TLE cache and CelesTrak pull log are written (<ADCS_DATA_DIR>/tle).
# Relative paths are relative to the repo root; created if missing.
# Default: output (i.e. <repo>/output, gitignored)
# ADCS_DATA_DIR=output
