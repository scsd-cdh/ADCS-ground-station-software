# Copy to .env and edit. Real environment variables override values in .env.
# Read by matlab/src/lib/loadConfig.m (and, later, the C++ ground station).

# Spacecraft NORAD catalog ID (25544 = ISS until SC-FREYR is catalogued)
ADCS_NORAD_ID=25544

# Ground station (Loyola). Altitude is a placeholder.
# 5 decimal places should be sufficient precision: https://gis.stackexchange.com/a/8674
ADCS_GS_LAT_DEG=45.45810
ADCS_GS_LON_DEG=-73.64031
ADCS_GS_ALT_M=50

# Minimum elevation for a communication window
ADCS_MIN_ELEVATION_DEG=10

# TLE source. CelesTrak refreshes about every 2 hours, do not poll faster.
# See the FAQ Addendum section: https://celestrak.org/NORAD/documentation/gp-data-formats.php
ADCS_TLE_SOURCE_URL=https://celestrak.org/NORAD/elements/gp.php
ADCS_TLE_POLL_INTERVAL_SEC=7200

# Where TLE caches, telemetry logs and demo results are written, by both the MATLAB
# and C++ code. Relative paths are relative to the repo root; created if missing.
# Default: output (i.e. <repo>/output, gitignored)
# ADCS_DATA_DIR=output
